<Window x:Class="Dusk.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dusk.Launcher.Views"
        Title="Dusk Launcher"
        Width="980" Height="640"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Left rail ─────────────────────────────────────────── -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DUSK" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Grid.Row="1" Text="LAUNCHER" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,24" />

                <StackPanel Grid.Row="2">
                    <Button x:Name="NavHome" Content="Home" Margin="0,0,0,8"
                            Tag="home" Click="OnNav" />
                    <Button x:Name="NavSettings" Content="Settings" Margin="0,0,0,8"
                            Tag="settings" Click="OnNav" />
                    <Button x:Name="NavFriends" Content="Friends" Margin="0,0,0,8"
                            Tag="friends" Click="OnNav" />
                    <Button x:Name="NavConnections" Content="Connections" Margin="0,0,0,8"
                            Tag="connections" Click="OnNav" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                    <TextBlock x:Name="AccountText" Foreground="{StaticResource TextDimBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis" />
                    <Button Content="Disconnect" Margin="0,8,0,0" Height="30"
                            Click="OnDisconnect" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content host ───────────────────────────────────────── -->
        <Grid Grid.Column="1">
            <views:HomeView x:Name="HomeView" x:FieldModifier="internal" />
            <views:SettingsView x:Name="SettingsView" Visibility="Collapsed" x:FieldModifier="internal" />
            <views:FriendsView x:Name="FriendsView" Visibility="Collapsed" x:FieldModifier="internal" />
            <views:ConnectionsView x:Name="ConnectionsView" Visibility="Collapsed" x:FieldModifier="internal" />
        </Grid>
    </Grid>
</Window>