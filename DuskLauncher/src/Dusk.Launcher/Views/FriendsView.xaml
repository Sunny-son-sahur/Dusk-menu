<UserControl x:Class="Dusk.Launcher.Views.FriendsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="FRIENDS" Style="{StaticResource SectionHeader}" />

        <!-- Friend list -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Discord friends on Gorilla Tag"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,8" />

                <TextBlock x:Name="EmptyText" Grid.Row="1" Grid.ColumnSpan="3"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12"
                           Text="No friends yet. Add a Discord ID below."
                           VerticalAlignment="Center" HorizontalAlignment="Center" />

                <ListBox x:Name="FriendList" Grid.Row="1" Grid.ColumnSpan="3"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextBrush}"
                         Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Add friend -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DiscordIdBox" Grid.Column="0" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" ToolTip="Discord user ID (right-click → copy ID in Discord)"
                     Text="Discord user ID" />
            <TextBox x:Name="NoteBox" Grid.Column="1" Margin="0,0,8,0"
                     VerticalContentAlignment="Center" Text="Note (optional)" />
            <Button Grid.Column="2" Content="Add" Margin="0,0,8,0" Click="OnAdd" />
            <Button Grid.Column="3" Content="Remove Selected" Click="OnRemove" />
        </Grid>
    </Grid>
</UserControl>