<Project Sdk="Microsoft.NET.Sdk">

  <!-- The installer is a tiny dark-themed WinForms app. It publishes as a
       single-file exe so GitHub Actions can hand you one portable build. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DuskInstaller</AssemblyName>
    <RootNamespace>Dusk.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>